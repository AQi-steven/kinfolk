# ===== 大模型（OpenAI 兼容接口）=====
# 全部可选：不配置则自动进入演示模式，全流程仍可跑通

# 密钥
LLM_API_KEY=

# 接口地址（任何 OpenAI 兼容网关）
LLM_BASE_URL=https://api.example.com/v1

# 模型名
LLM_MODEL=

# 强制演示模式（部署验证 / key 失效临时降级时用）
# LLM_DEMO=1

# ===== 鉴权 =====
# JWT 密钥。取值链：环境变量 → 此文件 → settings 表 → 随机生成
# 强烈建议用文件路径而不是直接写密钥
JWT_SECRET_FILE=./jwt.secret

# ===== 语音（腾讯云 ASR / TTS）=====
# 不配置则语音功能降级，其余功能不受影响
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ===== 运行时 =====
PORT=4000

# 强制 Node 启动参数（见 start.sh）
NODE_OPTIONS=--experimental-sqlite
