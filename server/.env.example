# 赛博家谱 LLM 配置
# 把本文件复制为同目录 .env 并填入真实值，即可启用真实大模型。
# 三项全部留空 → 自动进入“演示模式”（脚本化访谈，离线可跑）。
#
# 常见兼容端点：
#   腾讯混元:  LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1   LLM_MODEL=hunyuan-pro
#   DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1                LLM_MODEL=deepseek-chat
#   通义千问:  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   OpenAI:    LLM_BASE_URL=https://api.openai.com/v1                  LLM_MODEL=gpt-4o-mini

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 服务端口（已与“某项目”程序的 3000 端口错开，避免同机冲突）
PORT=4000
