{
  "name": "kinfolk",
  "version": "2.0.0",
  "description": "Kinfolk - voice-first AI oral biography. Elders talk; the AI listens, writes the memoir, and weaves everyone into a family tree. Biographies first, the family tree grows out of them.",
  "type": "commonjs",
  "main": "server/index.js",
  "scripts": {
    "start": "node --experimental-sqlite server/index.js",
    "dev": "node --experimental-sqlite server/index.js",
    "build:css": "tailwindcss -i src/tw.css -o web/_tw.css --minify",
    "watch:css": "tailwindcss -i src/tw.css -o web/_tw.css --watch",
    "predeploy": "npm run build:css"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^4.22.2",
    "tencentcloud-sdk-nodejs": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
